{
  "schemaVersion": 2,
  "id": "ilcorsaroblu",
  "name": "Il Corsaro Blu",
  "version": 1,
  "description": "Italian tracker: films and series in Italian. Needs your account (log in from Settings → Providers). Private: Play and Download not available yet.",
  "type": "html",
  "private": true,
  "categories": [
    "movie",
    "series"
  ],
  "languages": [
    "it"
  ],
  "baseUrls": [
    "https://ilcorsaroblu.org"
  ],
  "fetch": {
    "mode": "http",
    "headers": {
      "User-Agent": "Mozilla/5.0 (Linux; Android 16; Pixel 7a) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Mobile Safari/537.36",
      "Accept": "text/html,application/xhtml+xml",
      "Accept-Language": "it-IT,it;q=0.9"
    }
  },
  "auth": {
    "loginPath": "/index.php?page=login",
    "loggedOutMarker": "Non sei autorizzato",
    "cookies": [
      "uid",
      "pass"
    ]
  },
  "search": {
    "byQuery": "/index.php?page=torrents&search={query}",
    "byQueryEpisode": "/index.php?page=torrents&search={query} S{season:02}E{episode:02}"
  },
  "mapping": {
    "items": "a[href*=\"torrent-details\"] @closest tr",
    "fields": {
      "name": "a[href*=\"torrent-details\"]",
      "infohash": "a[href*=\"torrent-details\"]@href ~ id=([0-9a-fA-F]{40})",
      "torrentUrl": "a[href*=\"download.php\"]@href",
      "seeders": "a[href*=\"page=peers\"]"
    }
  },
  "limits": {
    "rps": 1,
    "timeoutMs": 15000,
    "maxResponseKb": 2048
  }
}
